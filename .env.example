# Environment Configuration for Journify

# Copy this file to .env and fill in your Supabase project credentials.
# Note: In Vite, variables exposed to the client must be prefixed with VITE_

# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Anonymous Public API Key (safe to use in browser)
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
